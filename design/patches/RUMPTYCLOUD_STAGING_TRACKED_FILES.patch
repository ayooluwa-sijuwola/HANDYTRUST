--- a/firestore.rules
+++ b/firestore.rules
@@ -1192,5 +1192,25 @@
       allow update: if false;
       allow delete: if false;
     }
+
+    // ─── RumptyCloud staging media (synthetic test media only) ───────────────
+    // functions/media.js is the only writer (Admin SDK). Clients may read the
+    // records they own (admins: all) and nothing else: no client can create,
+    // change (owner, object key, bucket, status, visibility, checksum) or
+    // delete a record, so an upload can never be forged or confirmed, and
+    // clean-up can never be bypassed, from the client.
+    match /media/{mediaId} {
+      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
+      allow create, update, delete: if false;
+    }
+    // Per-user upload counters and storage use (read-only for the owner).
+    match /media_quotas/{uid} {
+      allow read: if isOwner(uid) || isAdmin();
+      allow create, update, delete: if false;
+    }
+    // Global limits (server only).
+    match /media_system/{docId} {
+      allow read, create, update, delete: if false;
+    }
   }
 }
